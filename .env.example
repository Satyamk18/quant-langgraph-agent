# Choose LLM Provider: "gemini" (recommended, free tier) or "openai"
LLM_PROVIDER=gemini

# If using Gemini (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# If using OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Model name (default for gemini: gemini-2.5-flash or gemini-1.5-flash)
MODEL_NAME=gemini-2.5-flash
